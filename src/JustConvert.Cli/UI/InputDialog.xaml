<ui:FluentWindow x:Class="JustConvert.Cli.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
        Height="210" Width="420"
        MinHeight="210" MaxHeight="210"
        MinWidth="420" MaxWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="{core:Loc SettingsTitle}" ShowMaximize="False" ShowMinimize="False" Height="36"/>

        <StackPanel Grid.Row="1" Margin="24,10,24,10" VerticalAlignment="Center">
            <TextBlock x:Name="TxtPrompt" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <ui:TextBox x:Name="TxtInput" Height="34"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnOk" Appearance="Primary" Content="{core:Loc BtnYes}" IsDefault="True" Click="OnOkClick" Width="80"/>
                <ui:Button x:Name="BtnCancel" Content="{core:Loc BtnCancel}" IsCancel="True" Click="OnCancelClick" Margin="8,0,0,0" Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
