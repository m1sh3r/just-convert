<ui:FluentWindow x:Class="JustConvert.Cli.UI.PresetEditorDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
                  mc:Ignorable="d"
                  Title="{core:Loc PresetTitleNew}"
                  d:Title="Новый пресет"
                  Height="460"
                  Width="480"
                  MinHeight="460"
                  MaxHeight="460"
                  MinWidth="480"
                  MaxWidth="480"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="NoResize"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="{core:Loc PresetTitleNew}"
                     d:Title="Новый пресет"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Height="36"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      CanContentScroll="False"
                      Padding="24,8,24,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{core:Loc PromptPresetName}"
                               d:Text="Название пресета:"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <TextBox x:Name="TxtPresetName"
                             Grid.Column="1"
                             Height="32"
                             d:Text="Мой пресет"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{core:Loc LabelPresetCategory}"
                               d:Text="Категория:"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <ComboBox x:Name="CmbCategory"
                              Grid.Column="1"
                              Height="32"
                              SelectionChanged="OnCategoryChanged"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{core:Loc LabelPresetContainer}"
                               d:Text="Контейнер:"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <ComboBox x:Name="CmbContainer"
                              Grid.Column="1"
                              Height="32"/>
                </Grid>

                <!-- VIDEO SETTINGS -->
                <StackPanel x:Name="PanelVideoSettings" Visibility="Collapsed" d:Visibility="Visible">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{core:Loc LabelVideoCodec}"
                                   d:Text="Видеокодек:"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                        <ComboBox x:Name="CmbVideoCodec"
                                  Grid.Column="1"
                                  Height="32"
                                  SelectionChanged="OnVideoCodecChanged"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{core:Loc LabelEncoder}"
                                   d:Text="Энкодер:"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                        <ComboBox x:Name="CmbEncoder"
                                  Grid.Column="1"
                                  Height="32"/>
                    </Grid>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{core:Loc LabelQuality}"
                                   d:Text="Качество (CQ):"
                                   FontSize="13"/>
                        <TextBlock x:Name="TxtVideoCq"
                                   Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   d:Text="CQ 23"/>
                    </Grid>
                    <Slider x:Name="SliderVideoCq"
                            Minimum="15"
                            Maximum="35"
                            Value="23"
                            SmallChange="1"
                            LargeChange="2"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnVideoCqChanged"
                            Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{core:Loc LabelAudioBitrate}"
                                   d:Text="Битрейт аудио:"
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                        <ComboBox x:Name="CmbAudioBitrate"
                                  Grid.Column="1"
                                  Height="32"/>
                    </Grid>
                </StackPanel>

                <!-- AUDIO SETTINGS -->
                <StackPanel x:Name="PanelAudioSettings" Visibility="Collapsed">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{core:Loc LabelAudioBitrate}"
                                   d:Text="Битрейт аудио:"
                                   FontSize="13"/>
                        <TextBlock x:Name="TxtAudioBitrate"
                                   Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   d:Text="192 кбит/с"/>
                    </Grid>
                    <Slider x:Name="SliderAudioBitrate"
                            Minimum="64"
                            Maximum="320"
                            Value="192"
                            SmallChange="32"
                            LargeChange="64"
                            TickFrequency="32"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnAudioBitrateChanged"
                            Margin="0,0,0,8"/>
                </StackPanel>

                <!-- IMAGE SETTINGS -->
                <StackPanel x:Name="PanelImageSettings" Visibility="Collapsed">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{core:Loc LabelQuality}"
                                   d:Text="Качество:"
                                   FontSize="13"/>
                        <TextBlock x:Name="TxtImageQuality"
                                   Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   d:Text="90%"/>
                    </Grid>
                    <Slider x:Name="SliderImageQuality"
                            Minimum="1"
                            Maximum="100"
                            Value="90"
                            SmallChange="1"
                            LargeChange="5"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OnImageQualityChanged"
                            Margin="0,0,0,8"/>
                </StackPanel>

                <CheckBox x:Name="ChkAppendSuffix"
                          Content="{core:Loc ChkAppendQualitySuffix}"
                          d:Content="Добавлять суффикс параметров в имя файла"
                          IsChecked="True"
                          Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ApplicationBackgroundBrush}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="BtnCancel"
                           Content="{core:Loc BtnCancel}"
                           d:Content="Отмена"
                           Width="100"
                           Height="34"
                           Margin="0,0,10,0"
                           Click="BtnCancel_Click"/>
                <ui:Button x:Name="BtnSave"
                           Appearance="Primary"
                           Content="{core:Loc BtnApply}"
                           d:Content="Сохранить"
                           Width="110"
                           Height="34"
                           Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
