<ui:FluentWindow x:Class="JustConvert.Cli.UI.MessageDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
                  mc:Ignorable="d"
                  Title="{core:Loc SettingsTitle}"
                  d:Title="Just Convert"
                  Height="200"
                  Width="420"
                  MinHeight="200"
                  MaxHeight="200"
                  MinWidth="420"
                  MaxWidth="420"
                  WindowStartupLocation="CenterOwner"
                  ResizeMode="NoResize"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="{core:Loc SettingsTitle}"
                     d:Title="Just Convert"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Height="36"/>

        <Grid Grid.Row="1"
              Margin="24,10,24,10"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon x:Name="IconMessage"
                           Grid.Column="0"
                           Symbol="QuestionCircle24"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

            <TextBlock x:Name="TxtMessage"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       d:Text="Текст сообщения диалогового окна"/>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="BtnPrimary"
                           Appearance="Primary"
                           Content="{core:Loc BtnYes}"
                           d:Content="Да"
                           IsDefault="True"
                           Click="OnPrimaryClick"
                           Width="80"/>
                <ui:Button x:Name="BtnSecondary"
                           Content="{core:Loc BtnNo}"
                           d:Content="Нет"
                           IsCancel="True"
                           Click="OnSecondaryClick"
                           Margin="8,0,0,0"
                           Width="80"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
