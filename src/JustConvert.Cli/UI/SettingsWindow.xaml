<ui:FluentWindow x:Class="JustConvert.Cli.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
        Height="620" Width="780"
        MinHeight="620" MaxHeight="620"
        MinWidth="780" MaxWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="{core:Loc SettingsTitle}" ShowMaximize="False" ShowMinimize="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Height="36"/>

        <Border Grid.Row="1" Margin="24,6,24,12" Padding="16,14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="{core:Loc SettingsProfilesHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbProfiles" Grid.Column="0" VerticalAlignment="Center" Height="34" SelectionChanged="OnProfileSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="LockClosed20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisConverter}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <ui:Button x:Name="BtnDuplicate" Content="{core:Loc BtnDuplicate}" Icon="{ui:SymbolIcon Copy24}" Click="OnDuplicateProfileClick" Margin="0,0,6,0"/>
                        <ui:Button x:Name="BtnRename" Content="{core:Loc BtnRename}" Icon="{ui:SymbolIcon Edit24}" Click="OnRenameProfileClick" Margin="0,0,6,0"/>
                        <ui:Button x:Name="BtnDelete" Content="{core:Loc BtnDelete}" Icon="{ui:SymbolIcon Delete24}" Click="OnDeleteProfileClick" Margin="0,0,6,0"/>
                        <ui:Button x:Name="BtnExport" Content="{core:Loc BtnExport}" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnExportClick" Margin="0,0,6,0"/>
                        <ui:Button x:Name="BtnImport" Content="{core:Loc BtnImport}" Icon="{ui:SymbolIcon ArrowUpload24}" Click="OnImportClick"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TxtProfileNotice" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="TabsCategory" Margin="24,0,24,12" SelectionChanged="OnCategoryTabChanged">
            <TabItem Header="{core:Loc CategoryVideo}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel" Margin="4,8,4,4">
                    <StackPanel x:Name="PanelVideoFormats"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{core:Loc CategoryAudio}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel" Margin="4,8,4,4">
                    <StackPanel x:Name="PanelAudioFormats"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{core:Loc CategoryImages}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False" PreviewMouseWheel="OnScrollViewerPreviewMouseWheel" Margin="4,8,4,4">
                    <StackPanel x:Name="PanelImageFormats"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtApplyStatus" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="BtnApply" Appearance="Primary" Content="{core:Loc BtnApply}" Click="OnApplyClick" Width="100"/>
                    <ui:Button x:Name="BtnClose" Content="{core:Loc BtnClose}" Click="OnCloseClick" Margin="8,0,0,0" Width="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
