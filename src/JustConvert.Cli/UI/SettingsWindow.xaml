<ui:FluentWindow x:Class="JustConvert.Cli.UI.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
                  mc:Ignorable="d"
                  Title="{core:Loc SettingsTitle}"
                  d:Title="Just Convert — Настройки"
                  Height="620"
                  Width="800"
                  MinHeight="620"
                  MaxHeight="620"
                  MinWidth="800"
                  MaxWidth="800"
                  WindowStartupLocation="CenterScreen"
                  ResizeMode="NoResize"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ContentOnlyTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="{core:Loc SettingsTitle}"
                     d:Title="Just Convert — Настройки"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Height="36"/>

        <Border Grid.Row="1"
                Margin="20,4,20,10"
                Padding="16,10"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{core:Loc SettingsProfilesHeader}"
                               d:Text="Профиль контекстного меню:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <ComboBox x:Name="CmbProfiles"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Height="32"
                              ContextMenu="{Binding ElementName=BtnProfileMenu, Path=ContextMenu}"
                              SelectionChanged="OnProfileSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ui:Button x:Name="BtnProfileMenu"
                               Grid.Column="2"
                               Icon="{ui:SymbolIcon MoreHorizontal24}"
                               Width="34"
                               Height="32"
                               Margin="6,0,0,0"
                               Padding="0"
                               ToolTip="{core:Loc ProfileMenuTooltip}"
                               d:ToolTip="Действия с профилем"
                               Click="OnProfileMenuClick">
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="ProfileContextMenu">
                                <ui:MenuItem x:Name="MenuDuplicate"
                                             Header="{core:Loc BtnDuplicate}"
                                             d:Header="Дублировать"
                                             Icon="{ui:SymbolIcon Copy24}"
                                             Click="OnDuplicateProfileClick"/>
                                <ui:MenuItem x:Name="MenuRename"
                                             Header="{core:Loc BtnRename}"
                                             d:Header="Переименовать"
                                             Icon="{ui:SymbolIcon Edit24}"
                                             Click="OnRenameProfileClick"/>
                                <ui:MenuItem x:Name="MenuDelete"
                                             Header="{core:Loc BtnDelete}"
                                             d:Header="Удалить"
                                             Icon="{ui:SymbolIcon Delete24}"
                                             Click="OnDeleteProfileClick"/>
                                <Separator/>
                                <ui:MenuItem x:Name="MenuResetDefaults"
                                             Header="{core:Loc BtnResetDefaults}"
                                             d:Header="Сбросить к стандартным"
                                             Icon="{ui:SymbolIcon ArrowReset24}"
                                             Click="OnResetDefaultsClick"/>
                                <Separator/>
                                <ui:MenuItem x:Name="MenuExport"
                                             Header="{core:Loc BtnExport}"
                                             d:Header="Экспорт..."
                                             Icon="{ui:SymbolIcon ArrowDownload24}"
                                             Click="OnExportClick"/>
                                <ui:MenuItem x:Name="MenuImport"
                                             Header="{core:Loc BtnImport}"
                                             d:Header="Импорт..."
                                             Icon="{ui:SymbolIcon ArrowUpload24}"
                                             Click="OnImportClick"/>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>

                <CheckBox x:Name="ChkAppendQualitySuffix"
                          Grid.Row="1"
                          Content="{core:Loc ChkAppendQualitySuffix}"
                          d:Content="Добавлять суффикс формата и заданных настроек в имя файла"
                          Margin="0,6,0,0"
                          Checked="OnAppendQualitySuffixChanged"
                          Unchecked="OnAppendQualitySuffixChanged"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="NavView"
                               Grid.Column="0"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               OpenPaneLength="200"
                               IsPaneOpen="True"
                               HeaderVisibility="Collapsed"
                               AlwaysShowHeader="False"
                               IsTopSeparatorVisible="False"
                               IsFooterSeparatorVisible="False"
                               Background="Transparent"
                               BorderThickness="0"
                               SelectionChanged="OnNavViewSelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="NavItemVideo"
                                           Content="{core:Loc CategoryVideo}"
                                           d:Content="Видео"
                                           Icon="{ui:SymbolIcon Video24}"
                                           Tag="0"
                                           IsActive="True"
                                           Click="OnNavItemClick"/>
                    <ui:NavigationViewItem x:Name="NavItemAudio"
                                           Content="{core:Loc CategoryAudio}"
                                           d:Content="Аудио"
                                           Icon="{ui:SymbolIcon MusicNote224}"
                                           Tag="1"
                                           Click="OnNavItemClick"/>
                    <ui:NavigationViewItem x:Name="NavItemImages"
                                           Content="{core:Loc CategoryImages}"
                                           d:Content="Изображения"
                                           Icon="{ui:SymbolIcon Image24}"
                                           Tag="2"
                                           Click="OnNavItemClick"/>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <Rectangle Grid.Column="1"
                       Fill="{DynamicResource CardStrokeColorDefaultBrush}"
                       Width="1"
                       VerticalAlignment="Stretch"/>

            <TabControl Grid.Column="2"
                        x:Name="TabsCategory"
                        Style="{StaticResource ContentOnlyTabControlStyle}"
                        Margin="16,0,0,0"
                        SelectedIndex="0"
                        SelectionChanged="OnCategoryTabChanged">
                <TabItem Header="{core:Loc CategoryVideo}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Margin="0,4,8,4">
                        <StackPanel x:Name="PanelVideoFormats"
                                Margin="0,0,8,12"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{core:Loc CategoryAudio}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Margin="0,4,8,4">
                        <StackPanel x:Name="PanelAudioFormats"
                                Margin="0,0,8,12"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{core:Loc CategoryImages}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False"
                              Margin="0,4,8,4">
                        <StackPanel x:Name="PanelImageFormats"
                                Margin="0,0,8,12"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3"
                Padding="20,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtApplyStatus"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ui:Button x:Name="BtnApply"
                               Appearance="Primary"
                               Content="{core:Loc BtnApply}"
                               d:Content="Применить"
                               Click="OnApplyClick"
                               Width="100"/>
                    <ui:Button x:Name="BtnClose"
                               Content="{core:Loc BtnClose}"
                               d:Content="Закрыть"
                               IsCancel="True"
                               Click="OnCloseClick"
                               Margin="8,0,0,0"
                               Width="90"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
