<ui:FluentWindow x:Class="JustConvert.Cli.UI.ConversionProgressWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
                 xmlns:local="clr-namespace:JustConvert.Cli.UI"
                 mc:Ignorable="d"
                 Title="{core:Loc QueueTitle}"
                 Height="440"
                 Width="560"
                 MinHeight="400"
                 MinWidth="560"
                 MaxWidth="560"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     x:Name="AppTitleBar"
                     Title="{core:Loc QueueTitle}"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Height="36"/>

        <Grid Grid.Row="1"
              Margin="24,4,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon x:Name="IconOverall"
                           Grid.Column="0"
                           Symbol="ArrowSync24"
                           FontSize="22"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           RenderTransformOrigin="0.5,0.5">
                <ui:SymbolIcon.RenderTransform>
                    <RotateTransform x:Name="IconRotateTransform"
                                     Angle="0"/>
                </ui:SymbolIcon.RenderTransform>
            </ui:SymbolIcon>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TxtOverallStatus"
                           Text="{core:Loc StatusPreparing}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ProgressBar x:Name="OverallProgressBar"
                             Height="3"
                             Margin="0,6,0,0"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                             Minimum="0"
                             Maximum="100"
                             d:Value="50"/>
            </StackPanel>

            <TextBlock x:Name="TxtOverallCount"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       d:Text="2 / 4"/>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="24,0,24,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      CanContentScroll="False">
            <ItemsControl x:Name="QueueItemsList"
                          d:ItemsSource="{x:Static local:DesignData.SampleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="10,6"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="{Binding StatusSymbol}"
                                               FontSize="18"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding StatusBrush}"/>

                                <Grid Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="Medium"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TargetFormatDisplay}"
                                                   FontSize="11"
                                                   Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ProgressBar Grid.Row="0"
                                                     Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercentage}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding ProgressBarBrush}"
                                                     Visibility="Visible"
                                                     Margin="0,4,0,3"/>

                                        <Grid Grid.Row="1"
                                              Margin="0,2,0,0">
                                            <TextBlock Text="{Binding DisplayStatus}"
                                                       FontSize="11"
                                                       Foreground="{Binding StatusTextBrush}"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button Appearance="Transparent"
                                               Padding="6,4"
                                               Margin="0,0,4,0"
                                               ToolTip="{Binding PauseResumeTooltip}"
                                               Visibility="{Binding PauseResumeVisibility}"
                                               Click="BtnItemPauseResume_Click"
                                               Tag="{Binding}">
                                        <ui:SymbolIcon Symbol="{Binding PauseResumeSymbol}"
                                                       FontSize="14"/>
                                    </ui:Button>

                                    <ui:Button Appearance="Transparent"
                                               Padding="6,4"
                                               ToolTip="{core:Loc TooltipCancel}"
                                               Visibility="{Binding CancelVisibility}"
                                               Click="BtnItemCancel_Click"
                                               Tag="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss16"
                                                       FontSize="14"/>
                                    </ui:Button>

                                    <ui:Button Appearance="Transparent"
                                               Padding="6,4"
                                               Margin="0,0,4,0"
                                               ToolTip="{core:Loc TooltipCopyError}"
                                               Visibility="{Binding ErrorButtonVisibility}"
                                               Click="BtnItemCopyError_Click"
                                               Tag="{Binding}">
                                        <ui:SymbolIcon Symbol="Copy16"
                                                       FontSize="14"/>
                                    </ui:Button>

                                    <ui:Button Appearance="Transparent"
                                               Padding="6,4"
                                               ToolTip="{core:Loc TooltipError}"
                                               Visibility="{Binding ErrorButtonVisibility}"
                                               Click="BtnItemError_Click"
                                               Tag="{Binding}">
                                        <ui:SymbolIcon Symbol="Info16"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{core:Loc LabelParallelConversions}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:Button x:Name="BtnParallelDec"
                                       Appearance="Transparent"
                                       Padding="6,4"
                                       Click="BtnParallelDec_Click">
                                <ui:SymbolIcon Symbol="Subtract16"
                                               FontSize="12"/>
                            </ui:Button>

                            <TextBlock x:Name="TxtParallelValue"
                                       Text="1"
                                       Width="26"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                            <ui:Button x:Name="BtnParallelInc"
                                       Appearance="Transparent"
                                       Padding="6,4"
                                       Click="BtnParallelInc_Click">
                                <ui:SymbolIcon Symbol="Add16"
                                               FontSize="12"/>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCopyErrors"
                               Click="BtnCopyErrors_Click"
                               Margin="0,0,8,0"
                               Visibility="Collapsed"
                               d:Visibility="Visible"
                               MinWidth="110">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy16"
                                           Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtBtnCopyErrors"
                                       Text="{core:Loc BtnCopyAllErrors}"
                                       d:Text="Копировать логи ошибок"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="BtnPauseAll"
                               Content="{core:Loc BtnPauseAll}"
                               d:Content="Пауза всех"
                               Click="BtnPauseAll_Click"
                               Margin="0,0,8,0"
                               MinWidth="110"/>
                    <ui:Button x:Name="BtnCancelAll"
                               Content="{core:Loc BtnCancelAll}"
                               d:Content="Отменить все"
                               Click="BtnCancelAll_Click"
                               MinWidth="85"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Grid.RowSpan="3"
              x:Name="ErrorDetailOverlay"
              Visibility="Collapsed"
              d:Visibility="Collapsed"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              Margin="24,4,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:InfoBar Grid.Row="0"
                        x:Name="InfoBarError"
                        Title="{core:Loc TitleError}"
                        d:Title="Ошибка конвертации"
                        IsOpen="True"
                        Severity="Error"
                        IsClosable="False"
                        Margin="0,0,0,12"/>

            <ui:TextBox Grid.Row="1"
                        x:Name="TxtErrorLog"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        FontFamily="Consolas, monospace"
                        FontSize="11"
                        Padding="8"/>

            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,12,0,0"
                    Margin="0,12,0,0">
                <Grid>
                    <ui:Button x:Name="BtnCopy"
                               Click="BtnCopy_Click"
                               HorizontalAlignment="Left"
                               MinWidth="110">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy16"
                                           Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtBtnCopy"
                                       Text="{core:Loc BtnCopyError}"
                                       d:Text="Скопировать ошибку"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="BtnCloseError"
                               Content="{core:Loc BtnClose}"
                               d:Content="Закрыть"
                               Click="BtnCloseError_Click"
                               IsDefault="True"
                               IsCancel="True"
                               HorizontalAlignment="Right"
                               MinWidth="80"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>