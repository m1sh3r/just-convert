<ui:FluentWindow x:Class="JustConvert.Cli.UI.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
        Title="{core:Loc TitleError}"
        Height="360" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="{core:Loc TitleError}" ShowMaximize="False" ShowMinimize="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <Grid Grid.Row="1" Margin="24,4,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:InfoBar Grid.Row="0" x:Name="InfoBarError" Title="{core:Loc TitleError}" IsOpen="True" Severity="Error" IsClosable="False" Margin="0,0,0,12"/>

            <ui:TextBox Grid.Row="1" x:Name="TxtErrorLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, monospace" FontSize="11" Padding="8"/>
        </Grid>

        <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <ui:Button x:Name="BtnCopy" Content="{core:Loc BtnCopyError}" Click="BtnCopy_Click" HorizontalAlignment="Left" MinWidth="110"/>
                <ui:Button x:Name="BtnClose" Content="{core:Loc BtnClose}" Click="BtnClose_Click" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="80"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
