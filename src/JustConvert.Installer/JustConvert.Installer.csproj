<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>JustConvert-Setup</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustConvert.Cli\JustConvert.Cli.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" Publish="false" />
    <ProjectReference Include="..\JustConvert.ShellExtension\JustConvert.ShellExtension.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" Publish="false" />
    <ProjectReference Include="..\JustConvert.Core\JustConvert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="PreparePayloadZip" BeforeTargets="AssignTargetPaths;PrepareResourceNames" DependsOnTargets="MinVer">
    <PropertyGroup>
      <PayloadStagingDir>$(IntermediateOutputPath)payload\</PayloadStagingDir>
      <PayloadZipFile>$(IntermediateOutputPath)Payload.zip</PayloadZipFile>
      <RepoDistAppDir>$(MSBuildThisFileDirectory)..\..\dist\app</RepoDistAppDir>
    </PropertyGroup>

    <RemoveDir Directories="$(PayloadStagingDir)" />
    <MakeDir Directories="$(PayloadStagingDir)" />

    <ItemGroup Condition="'$(PayloadDir)' != '' And Exists('$(PayloadDir)')">
      <CustomPayloadFiles Include="$(PayloadDir)\**\*.*" Exclude="$(PayloadDir)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(CustomPayloadFiles)" DestinationFolder="$(PayloadStagingDir)%(RecursiveDir)" Condition="'@(CustomPayloadFiles)' != ''" />

    <ItemGroup Condition="'@(CustomPayloadFiles)' == '' And Exists('$(RepoDistAppDir)\just-convert.exe')">
      <DistPayloadFiles Include="$(RepoDistAppDir)\**\*.*" Exclude="$(RepoDistAppDir)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DistPayloadFiles)" DestinationFolder="$(PayloadStagingDir)%(RecursiveDir)" Condition="'@(DistPayloadFiles)' != ''" />

    <ItemGroup Condition="'@(CustomPayloadFiles)' == '' And '@(DistPayloadFiles)' == ''">
      <CliPayloadFiles Condition="Exists('..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\win-x64\publish\just-convert.exe')" Include="..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\win-x64\publish\*.*" Exclude="*.pdb" />
      <CliPayloadFiles Condition="'@(CliPayloadFiles)' == '' And Exists('..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\win-x64\just-convert.exe')" Include="..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\win-x64\*.*" Exclude="*.pdb" />
      <CliPayloadFiles Condition="'@(CliPayloadFiles)' == '' And Exists('..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\just-convert.exe')" Include="..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\*.*" Exclude="*.pdb" />

      <ShellExPayloadFiles Condition="Exists('..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\win-x64\publish\JustConvert.ShellExtension.dll')" Include="..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\win-x64\publish\*.*" Exclude="*.pdb" />
      <ShellExPayloadFiles Condition="'@(ShellExPayloadFiles)' == '' And Exists('..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\win-x64\JustConvert.ShellExtension.dll')" Include="..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\win-x64\*.*" Exclude="*.pdb" />
      <ShellExPayloadFiles Condition="'@(ShellExPayloadFiles)' == '' And Exists('..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\JustConvert.ShellExtension.dll')" Include="..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\*.*" Exclude="*.pdb" />

      <ManifestFile Include="$(MSBuildThisFileDirectory)..\..\manifests\AppxManifest.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(CliPayloadFiles)" DestinationFolder="$(PayloadStagingDir)" Condition="'@(CliPayloadFiles)' != ''" />
    <Copy SourceFiles="@(ShellExPayloadFiles)" DestinationFolder="$(PayloadStagingDir)" Condition="'@(ShellExPayloadFiles)' != ''" />
    <Copy SourceFiles="@(ManifestFile)" DestinationFolder="$(PayloadStagingDir)" Condition="'@(ManifestFile)' != ''" />

    <Error Condition="!Exists('$(PayloadStagingDir)just-convert.exe')" Text="Payload staging directory is missing just-convert.exe. Build or publish JustConvert.Cli first." />

    <XmlPoke XmlInputPath="$(PayloadStagingDir)AppxManifest.xml"
             Query="/ns:Package/ns:Identity/@Version"
             Value="$(FileVersion)"
             Namespaces="&lt;Namespace Prefix='ns' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;"
             Condition="Exists('$(PayloadStagingDir)AppxManifest.xml') And '$(FileVersion)' != ''" />

    <ZipDirectory SourceDirectory="$(PayloadStagingDir)" DestinationFile="$(PayloadZipFile)" Overwrite="true" />

    <ItemGroup>
      <EmbeddedResource Include="$(PayloadZipFile)">
        <LogicalName>Payload.zip</LogicalName>
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CopyPayloadFiles" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <CliOutputFiles Include="..\JustConvert.Cli\bin\$(Configuration)\net10.0-windows\just-convert.*" />
      <ShellExOutputFiles Include="..\JustConvert.ShellExtension\bin\$(Configuration)\net10.0-windows\JustConvert.ShellExtension.*" />
      <ManifestFiles Include="$(MSBuildThisFileDirectory)..\..\manifests\AppxManifest.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(CliOutputFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ShellExOutputFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ManifestFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
