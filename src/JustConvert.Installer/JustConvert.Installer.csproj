<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>JustConvert-Setup</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustConvert.Cli\JustConvert.Cli.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" Publish="false" />
    <ProjectReference Include="..\JustConvert.Core\JustConvert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="PreparePayloadZip" BeforeTargets="AssignTargetPaths;PrepareResourceNames" DependsOnTargets="MinVer">
    <PropertyGroup>
      <PayloadStagingDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)payload\'))</PayloadStagingDir>
      <PayloadZipFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Payload.zip'))</PayloadZipFile>
      <RepoDistAppDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\dist\app'))</RepoDistAppDir>
    </PropertyGroup>

    <RemoveDir Directories="$(PayloadStagingDir)" />
    <MakeDir Directories="$(PayloadStagingDir)" />

    <ItemGroup Condition="'$(PayloadDir)' != '' And Exists('$(PayloadDir)')">
      <CustomPayloadFiles Include="$(PayloadDir)\**\*.*" Exclude="$(PayloadDir)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(CustomPayloadFiles)" DestinationFolder="$(PayloadStagingDir)%(RecursiveDir)" Condition="'@(CustomPayloadFiles)' != ''" />

    <ItemGroup Condition="'@(CustomPayloadFiles)' == '' And Exists('$(RepoDistAppDir)\just-convert.exe')">
      <DistPayloadFiles Include="$(RepoDistAppDir)\**\*.*" Exclude="$(RepoDistAppDir)\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DistPayloadFiles)" DestinationFolder="$(PayloadStagingDir)%(RecursiveDir)" Condition="'@(DistPayloadFiles)' != ''" />

    <PropertyGroup>
      <EffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</EffectiveRuntimeIdentifier>
      <EffectiveRuntimeIdentifier Condition="'$(EffectiveRuntimeIdentifier)' == '' And '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</EffectiveRuntimeIdentifier>
      <EffectiveRuntimeIdentifier Condition="'$(EffectiveRuntimeIdentifier)' == ''">win-x64</EffectiveRuntimeIdentifier>
    </PropertyGroup>

    <Exec Condition="'@(CustomPayloadFiles)' == '' And '@(DistPayloadFiles)' == ''"
          Command="dotnet publish &quot;..\JustConvert.Cli\JustConvert.Cli.csproj&quot; -c $(Configuration) -r $(EffectiveRuntimeIdentifier) --self-contained false -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:PublishReadyToRun=true -o &quot;$(PayloadStagingDir)&quot;" />

    <Error Condition="!Exists('$(PayloadStagingDir)just-convert.exe')" Text="Payload staging directory is missing just-convert.exe." />

    <ZipDirectory SourceDirectory="$(PayloadStagingDir)" DestinationFile="$(PayloadZipFile)" Overwrite="true" />

    <ItemGroup>
      <EmbeddedResource Include="$(PayloadZipFile)">
        <LogicalName>Payload.zip</LogicalName>
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="NameVersionedInstaller" AfterTargets="Publish" DependsOnTargets="MinVer">
    <PropertyGroup>
      <CleanVersion Condition="'$(MinVerVersion)' != ''">$(MinVerVersion)</CleanVersion>
      <CleanVersion Condition="'$(CleanVersion)' == ''">$(Version)</CleanVersion>
    </PropertyGroup>

    <Move SourceFiles="$(PublishDir)JustConvert-Setup.exe"
          DestinationFiles="$(PublishDir)JustConvert-$(CleanVersion)-Setup.exe"
          Condition="Exists('$(PublishDir)JustConvert-Setup.exe') And '$(CleanVersion)' != ''" />
    <Delete Files="$(PublishDir)JustConvert-Setup.exe"
            Condition="Exists('$(PublishDir)JustConvert-Setup.exe')" />
  </Target>

</Project>
