<ui:FluentWindow x:Class="JustConvert.Installer.UI.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:core="clr-namespace:JustConvert.Core;assembly=JustConvert.Core"
        Title="{core:Loc SetupTitle}"
        Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Title="{core:Loc SetupTitle}" ShowMaximize="False" ShowMinimize="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Height="48" VerticalAlignment="Center"/>

        <Grid Grid.Row="1" Margin="16,16,16,16">
            <StackPanel x:Name="HeaderPanel" VerticalAlignment="Top" Margin="0,0,0,16"/>

            <StackPanel x:Name="ConfigPanel" VerticalAlignment="Center">
                <StackPanel Margin="0,0,0,16">
                    <TextBlock x:Name="TxtScopeLabel" Text="{core:Loc SetupScopeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="RadioCurrentUser" Content="{core:Loc SetupScopeCurrentUser}" IsChecked="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RadioAllUsers" Content="{core:Loc SetupScopeAllUsers}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <StackPanel>
                    <CheckBox x:Name="ChkFfmpeg" Content="{core:Loc SetupFfmpegCheckbox}" IsChecked="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Checked="ChkFfmpeg_Checked"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBar" Height="6" IsIndeterminate="True" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtStatus" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <ui:InfoBar x:Name="InfoBarSuccess" Title="{core:Loc SetupSuccessHeader}" IsOpen="True" Severity="Success" IsClosable="False" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtSuccessText" Text="{core:Loc SetupSuccessText}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <ui:InfoBar x:Name="InfoBarError" Title="{core:Loc SetupErrorHeader}" IsOpen="True" Severity="Error" IsClosable="False" Margin="0,0,0,12"/>
                <ui:TextBox x:Name="TxtErrorLog" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,295,0,0">
            <Grid>
                <ui:Button x:Name="BtnUninstall" Content="{core:Loc SetupBtnUninstall}" Click="BtnUninstall_Click" HorizontalAlignment="Left" MinWidth="90"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BtnInstall" Content="{core:Loc SetupBtnInstall}" Click="BtnInstall_Click" IsDefault="True" MinWidth="90" Margin="0,0,8,0"/>
                    <ui:Button x:Name="BtnClose" Content="{core:Loc BtnCancel}" Click="BtnClose_Click" IsCancel="True" MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>