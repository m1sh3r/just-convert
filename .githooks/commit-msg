#!/bin/sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

case "$COMMIT_MSG" in
    fixup\!*|squash\!*|Merge*|Revert*|"WIP:"*)
        exit 0
        ;;
esac

PATTERN='^(feat|fix|refactor|format|docs|chore|test|revert)\((ui|cli|core|installer|i18n|config|docs|tests)\): .+'

if ! echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
    echo ""
    echo "================================================================================"
    echo " [COMMITLINT] ОШИБКА: Неверный формат сообщения коммита!"
    echo "--------------------------------------------------------------------------------"
    echo " Ваше сообщение: \"$COMMIT_MSG\""
    echo ""
    echo " Ожидаемый формат: <type>(<scope>): <результат в прошедшем времени без точки>"
    echo ""
    echo " Разрешенные типы (type):"
    echo "   feat, fix, refactor, format, docs, chore, test, revert"
    echo ""
    echo " Разрешенные области (scope):"
    echo "   ui, cli, core, installer, i18n, config, docs, tests"
    echo ""
    echo " Правила:"
    echo "   - ui: графический интерфейс (WPF, XAML, стили, окна, анимации, контролы)"
    echo "   - cli: аргументы командной строки, флаги, headless-режим"
    echo "   - Запрещены имена файлов (.cs, .xaml) и переменных в описании"
    echo "   - Запрещена точка на конце"
    echo ""
    echo " Примеры:"
    echo "   feat(ui): добавлен диалог параметров конвертации"
    echo "   fix(ui): исправлена плавная прокрутка на тачпадах"
    echo "   feat(core): добавлен расчет суммарного веса файлов"
    echo "   feat(cli): добавлен флаг тихой конвертации --silent"
    echo "================================================================================"
    echo ""
    exit 1
fi

if echo "$COMMIT_MSG" | grep -Eq '\.$'; then
    echo ""
    echo "================================================================================"
    echo " [COMMITLINT] ОШИБКА: Сообщение коммита не должно заканчиваться точкой!"
    echo " Ваше сообщение: \"$COMMIT_MSG\""
    echo "================================================================================"
    echo ""
    exit 1
fi

if echo "$COMMIT_MSG" | grep -Eiq '\.(cs|xaml|csproj|slnx|json|md)\b'; then
    echo ""
    echo "================================================================================"
    echo " [COMMITLINT] ОШИБКА: Запрещено использовать прямые имена файлов в сообщении!"
    echo " Опишите суть изменения в терминах функционала (например, «параметры конвертации»"
    echo " вместо имени файла/класса)."
    echo " Ваше сообщение: \"$COMMIT_MSG\""
    echo "================================================================================"
    echo ""
    exit 1
fi

exit 0
