{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Installer (JustConvert-Setup)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/JustConvert.Installer/bin/Debug/net10.0-windows/JustConvert-Setup.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Debug CLI: List Formats",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/JustConvert.Cli/bin/Debug/net10.0-windows/just-convert.dll",
      "args": ["list"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Debug CLI: Convert File (with Window UI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/JustConvert.Cli/bin/Debug/net10.0-windows/just-convert.dll",
      "args": ["convert", "sample.png", "--to", "webp"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Debug CLI: Install Menus",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/JustConvert.Cli/bin/Debug/net10.0-windows/just-convert.dll",
      "args": ["install", "--currentuser"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
