{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Installer (UI)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/JustConvert.Installer/JustConvert.Installer.csproj"
    },
    {
      "name": "Installer (Silent Install)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/JustConvert.Installer/JustConvert.Installer.csproj",
      "args": ["--silent"]
    },
    {
      "name": "Installer (Silent Uninstall)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/JustConvert.Installer/JustConvert.Installer.csproj",
      "args": ["--silent", "--uninstall"]
    }
  ]
}