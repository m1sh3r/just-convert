{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Solution",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "JustConvert.slnx"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Publish Single-File Installer",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "src/JustConvert.Installer/JustConvert.Installer.csproj",
                "/p:PublishProfile=FolderProfile"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
